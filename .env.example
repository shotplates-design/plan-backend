ENVIRONMENT=development

# Postgres (docker compose up -d db, or a local Postgres)
DATABASE_URL=postgresql+psycopg://plan:plan@localhost:5432/plan
# SQLite fallback for quick hacking (no Postgres needed):
# DATABASE_URL=sqlite:///./plan.db

# Used by pytest (tests drop & recreate all tables in this DB!)
TEST_DATABASE_URL=postgresql+psycopg://plan:plan@localhost:5432/plan_test

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_MINUTES=10080
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# JSON list of allowed browser origins for the frontend
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Play-money economy (cents)
SIGNUP_BONUS_CENTS=100000
MIN_STAKE_CENTS=100
MAX_STAKE_CENTS=1000000
MAX_PARLAY_LEGS=12

ODDS_PROVIDER=mock
# The Odds API key (optional). Leave empty to serve Plan Data's odds JSON snapshot
# (plan-nfl-data/odds/prop_lines_week5_2026.json) and sample dual-book lines.
ODDS_API_KEY=

# ---------------------------------------------------------------------------- Paywall
# Pay-per-use: FREE_TRIES lifetime free tries per user, then credit packs.
# One try = opening one prop's hit-rate detail (GET /api/v1/games/{gameId}/props/{propId}).
# Board/list views and play-money bets never consume tries.
# OFF until billing is live (owner decision). false = all props unlocked, nothing counted.
# Flip to true together with BILLING_ENABLED=true.
PAYWALL_ENABLED=false
FREE_TRIES=10
# Re-opening the same prop is free within: day (same America/New_York day) | forever
PAYWALL_REOPEN_SCOPE=day
# What locked props show on board/list endpoints: last5 (teaser) | none
PAYWALL_BOARD_TEASER=last5

# ---------------------------------------------------------------------------- Billing (Stripe)
# TEST MODE ONLY: sk_live_/rk_live_ keys are refused everywhere (API, webhooks, setup script).
# Purchases on/off (stands in for Stripe restricted-business approval). While false, checkout
# returns 503 BILLING_DISABLED; free tries and already-purchased tries keep working.
BILLING_ENABLED=false
# pending | approved | declined (informational)
STRIPE_APPROVAL_STATUS=pending
# none | pause | season_pass (stub; not enforced)
BILLING_OFFSEASON_MODE=none

# sk_test_... or rk_test_... (Dashboard > Developers > API keys, test mode)
STRIPE_SECRET_KEY=
# whsec_... printed by `stripe listen` (or the test webhook endpoint)
STRIPE_WEBHOOK_SECRET=
# pk_test_... (exposed via GET /api/v1/billing/plans)
STRIPE_PUBLISHABLE_KEY=
STRIPE_API_VERSION=2025-10-29.clover

# Credit packs (one-time Prices found by lookup_key; create them with `python -m app.cli stripe-setup`).
# Default: small = 30 tries / $3.00, large = 100 tries / $5.00. Override as JSON if needed:
# CREDIT_PACKS=[{"key":"small","name":"30 tries","tries":30,"unit_amount":300,"lookup_key":"plan_tries_30_v1"},{"key":"large","name":"100 tries","tries":100,"unit_amount":500,"lookup_key":"plan_tries_100_v1"}]

CHECKOUT_SUCCESS_URL=http://localhost:3000/billing/success?session_id={CHECKOUT_SESSION_ID}
CHECKOUT_CANCEL_URL=http://localhost:3000/pricing?canceled=1
